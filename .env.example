# Optional: copy to .env before docker compose up -d.
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
MONITORING_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=byteguard-demo
# For a different controller address/port, copy Prometheus.yml, change its
# targets, and point here. Controller --metrics-address must match the target.
# PROMETHEUS_CONFIG=./configs/prometheus-local.yml
